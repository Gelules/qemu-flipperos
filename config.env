# config.env - default settings for the qemu-flipperos scripts.
#
# Every value can be overridden from the environment, for example:
#
#     PROFILE=Router MEMORY=2G ./scripts/05-run.sh
#
# This file is sourced by scripts/lib.sh. Keep the VAR=${VAR:-default} form:
# it means "use the environment value if there is one, else the default".

# --- Where the images come from ---------------------------------------------

# Build server directory that holds one sub-directory per build.
# The HTML listing is drawn by JavaScript; the scripts read manifest.json.
BASE_URL=${BASE_URL:-https://dl-linux-images.flipp.dev/full-img}

# Build to prepare with setup.sh and 02-download.sh: a build ID such as
# "2407" or "2410-test-falcon", or "latest" for the newest build without a
# label (labels mark test builds of other branches, pull requests or manual
# builds).
BUILD_ID=${BUILD_ID:-latest}

# Image variants to look for in a build, in order of preference.
# "nobootloader" is the disk image without U-Boot, the natural input for QEMU.
# A board image ("sige5", ...) has the same partitions plus a bootloader that
# QEMU simply ignores, so it works as a fallback.
IMAGE_VARIANTS=${IMAGE_VARIANTS:-nobootloader sige5}

# Directory for downloads, extracted kernels, VM disks and logs.
WORK_DIR=${WORK_DIR:-$TOP_DIR/work}

# --- What to boot -----------------------------------------------------------

# FlipperOS profile to boot (a btrfs subvolume named @<PROFILE>).
# Minimal is the reference under QEMU.
PROFILE=${PROFILE:-Minimal}

# Optional root subvolume override, for example "@MyProfile": boot that
# subvolume with the kernel and initrd of PROFILE. Useful for a profile
# created inside the VM. Leave empty to boot @<PROFILE>.
ROOT_SUBVOL=${ROOT_SUBVOL:-}

# --- Virtual machine --------------------------------------------------------

# Guest RAM, number of virtual CPUs and CPU model.
# cortex-a72 matches the big cores of the RK3576. "max" boots a little faster
# with QEMU 11, but gives the guest CPU features the RK3576 does not have.
MEMORY=${MEMORY:-4G}
CPUS=${CPUS:-4}
CPU_MODEL=${CPU_MODEL:-cortex-a72}

# Virtual size of the writable disk (a qcow2 overlay on top of the image).
# FlipperOS grows its root file system to fill it on the first boot.
DISK_SIZE=${DISK_SIZE:-16G}

# --- Network ----------------------------------------------------------------

# Host address the forwarded ports listen on. Keep 127.0.0.1 unless you
# really want other machines to reach the VM: SSH uses a well-known default
# password (user / user).
BIND_ADDR=${BIND_ADDR:-127.0.0.1}

# Host ports forwarded to the FlipCTL remote view (guest port 8899) and to
# SSH (guest port 22) by 05-run.sh.
FLIPCTL_PORT=${FLIPCTL_PORT:-8899}
SSH_PORT=${SSH_PORT:-2222}

# Separate ports for 06-smoke-test.sh, so a test can run next to a VM
# started with 05-run.sh.
TEST_FLIPCTL_PORT=${TEST_FLIPCTL_PORT:-18899}
TEST_SSH_PORT=${TEST_SSH_PORT:-12222}

# --- Smoke test -------------------------------------------------------------

# Seconds to wait for the guest to answer on SSH and FlipCTL. A boot takes
# about one minute on a recent PC (there is no KVM for an ARM guest on an
# x86 host, everything is emulated).
BOOT_TIMEOUT=${BOOT_TIMEOUT:-600}

# Seconds to wait for the guest clock to be set by NTP before the check
# reports a warning.
NTP_TIMEOUT=${NTP_TIMEOUT:-120}

# Login used for the in-guest checks (the FlipperOS default account).
GUEST_USER=${GUEST_USER:-user}
GUEST_PASSWORD=${GUEST_PASSWORD:-user}
